# Supabase Dashboard > Project Settings > API / API Keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SERVER ONLY. Never expose in frontend, commit, or copy to dist.
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy alternatives supported: SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.
APP_URL=http://localhost:5173
PORT=5173
# Only for npm run admin:create. Remove ADMIN_PASSWORD after bootstrap.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Configure email provider/SMTP inside Supabase Dashboard, not in this app.
